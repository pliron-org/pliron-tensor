  llvm.func @test_tensor_dim_sizes: llvm.func <llvm.void (llvm.ptr(0), builtin.fp32, llvm.ptr(0)) variadic = false> [] {
    ^entry(input_p: llvm.ptr(0), lowest: builtin.fp32, output_p: llvm.ptr(0)):
    input = llvm.load input_p : tensor.ranked<?x4:builtin.fp32>;
    idx0 = index.constant <index.constant 0> : index.index;
    rows = tensor.dim input, idx0 : index.index;
    init = tensor.splat lowest, rows : tensor.ranked<?x1:builtin.fp32>;
    row_max = tensor.reduce <Max> [1] input, init : tensor.ranked<?x1:builtin.fp32>;
    init_rows = tensor.dim init, idx0 : index.index;
    row_max_wide = tensor.broadcast row_max, init_rows : tensor.ranked<?x4:builtin.fp32>;
    result = tensor.sub input, row_max_wide : tensor.ranked<?x4:builtin.fp32>;
    llvm.store *output_p <- result;
