    llvm.func @test_transpose_write_live_source: llvm.func <llvm.void (llvm.ptr(0), builtin.integer i64, llvm.ptr(0), llvm.ptr(0)) variadic = false> [] {
      ^entry(src_p: llvm.ptr(0), value: builtin.integer i64, out_src_p: llvm.ptr(0), out_updated_p: llvm.ptr(0)):
